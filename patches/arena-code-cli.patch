+type CategoryKey = 'all' | string;
+
+function categoryLabel(category: CategoryKey): string {
+  return category === 'all' ? t('All') : t(category);
+}
+
+/** Window of categories that fits the strip, kept centred on the active one. */
+function categoryWindow(
+  labels: string[],
+  active: number,
+  budget: number,
+): { start: number; end: number } {
+  const cost = (label: string) => label.length + 3;
+  let start = active;
+  let used = cost(labels[active]);
+  while (start > 0 && used + cost(labels[start - 1]) <= budget) {
+    start -= 1;
+    used += cost(labels[start]);
+  }
+  let end = active;
+  while (end + 1 < labels.length && used + cost(labels[end + 1]) <= budget) {
+    end += 1;
+    used += cost(labels[end]);
+  }
+  return { start, end };
+}
